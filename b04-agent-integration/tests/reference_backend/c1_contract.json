{
  "contract_version": "C1",
  "source": {"document": "第十组 设计规格与开发任务编排.docx", "section": "2.2", "sha256": "1792776005ae3bc7985d3e01857ea5cc21eabb4fab3dd850edb60ac382e9edf0"},
  "owner": "B04 T03-T05 reference implementation tests; read-only transcription of team C1",
  "operations": [
    {"name":"register","method":"POST","path":"/api/v1/auth/register","authenticated":false,"required":["account","password","nickname"],"status":201,"data":"UserView"},
    {"name":"login","method":"POST","path":"/api/v1/auth/login","authenticated":false,"required":["account","password"],"status":200,"data":"LoginView"},
    {"name":"logout","method":"POST","path":"/api/v1/auth/logout","authenticated":true,"required":[],"status":200,"data":"Null"},
    {"name":"get_me","method":"GET","path":"/api/v1/me","authenticated":true,"required":[],"status":200,"data":"UserView"},
    {"name":"update_me","method":"PATCH","path":"/api/v1/me","authenticated":true,"required":["nickname"],"status":200,"data":"UserView"},
    {"name":"list_my_posts","method":"GET","path":"/api/v1/me/lost-items","authenticated":true,"query":["page","page_size"],"status":200,"data":"LostPage"},
    {"name":"list_my_claims","method":"GET","path":"/api/v1/me/claims","authenticated":true,"query":["page","page_size"],"status":200,"data":"ClaimPage"},
    {"name":"publish_lost","method":"POST","path":"/api/v1/lost-items","authenticated":true,"required":["name","description","location","lost_at"],"status":201,"data":"LostView"},
    {"name":"search_lost","method":"GET","path":"/api/v1/lost-items","authenticated":false,"query":["keyword","location","page","page_size"],"status":200,"data":"LostPage"},
    {"name":"get_lost","method":"GET","path":"/api/v1/lost-items/{id}","authenticated":false,"required":[],"status":200,"data":"LostView"},
    {"name":"create_claim","method":"POST","path":"/api/v1/lost-items/{id}/claims","authenticated":true,"required":["statement"],"status":201,"data":"ClaimView"}
  ],
  "errors": {"REQUIRED_FIELD":400,"INVALID_FIELD":400,"UNAUTHENTICATED":401,"FORBIDDEN":403,"NOT_FOUND":404,"DUPLICATE_ACCOUNT":409,"DUPLICATE_CLAIM":409,"INVALID_STATE":409,"INTERNAL_ERROR":500},
  "$defs": {
    "Uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "UserView":{"type":"object","additionalProperties":false,"required":["id","account","nickname","created_at"],"properties":{"id":{"$ref":"#/$defs/Uuid"},"account":{"type":"string","minLength":3,"maxLength":64,"pattern":"^[a-z0-9_]+$"},"nickname":{"type":"string","minLength":1,"maxLength":30},"created_at":{"$ref":"#/$defs/Time"}}},
    "LostView":{"type":"object","additionalProperties":false,"required":["id","name","description","location","lost_at","status","created_at"],"properties":{"id":{"$ref":"#/$defs/Uuid"},"name":{"type":"string","minLength":1,"maxLength":80},"description":{"type":"string","minLength":1,"maxLength":1000},"location":{"type":"string","minLength":1,"maxLength":120},"lost_at":{"$ref":"#/$defs/Time"},"status":{"const":"waiting"},"created_at":{"$ref":"#/$defs/Time"}}},
    "ClaimView":{"type":"object","additionalProperties":false,"required":["id","lost_item_id","statement","status","created_at"],"properties":{"id":{"$ref":"#/$defs/Uuid"},"lost_item_id":{"$ref":"#/$defs/Uuid"},"statement":{"type":"string","minLength":1,"maxLength":500},"status":{"const":"pending"},"created_at":{"$ref":"#/$defs/Time"}}},
    "LoginView":{"type":"object","additionalProperties":false,"required":["token","expires_at","user"],"properties":{"token":{"type":"string","minLength":43},"expires_at":{"$ref":"#/$defs/Time"},"user":{"$ref":"#/$defs/UserView"}}},
    "Null":{"type":"null"},
    "LostPage":{"type":"object","additionalProperties":false,"required":["items","page","page_size","total"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/LostView"}},"page":{"type":"integer","minimum":1},"page_size":{"type":"integer","minimum":1,"maximum":100},"total":{"type":"integer","minimum":0}}},
    "ClaimPage":{"type":"object","additionalProperties":false,"required":["items","page","page_size","total"],"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/ClaimView"}},"page":{"type":"integer","minimum":1},"page_size":{"type":"integer","minimum":1,"maximum":100},"total":{"type":"integer","minimum":0}}}
  }
}
