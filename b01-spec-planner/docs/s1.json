  "data_model": {
    "User": {
      "fields": [
        "id",
        "account",
        "password_hash",
        "nickname",
        "created_at"
      ],
      "constraints": [
        "account 唯一且按小写存储",
        "password_hash 不得出现在公开响应"
      ]
    },
    "LostItem": {
      "fields": [
        "id",
        "publisher_id",
        "name",
        "description",
        "location",
        "lost_at",
        "status",
        "created_at"
      ],
      "constraints": [
        "publisher_id 关联 User",
        "lost_at 带时区且必填",
        "status 仅 waiting"
      ]
    },
    "ClaimApplication": {
      "fields": [
        "id",
        "lost_item_id",
        "applicant_id",
        "statement",
        "status",
        "created_at"
      ],
      "constraints": [
        "对象与申请人必须存在",
        "(lost_item_id, applicant_id) 唯一",
        "status 仅 pending"
      ]
    }
  },
  "environment_constraints": [
    "HTTP JSON，统一前缀 /api/v1",
    "所有 id 为服务端生成的 UUID 字符串",
    "时间统一输出 UTC ISO 8601 三位毫秒",
