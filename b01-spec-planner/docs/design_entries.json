[
  {
    "design_id": "DS-AUTH-01",
    "module": "用户与身份",
    "req_refs": [
      "LR-01"
    ],
    "contract_refs": [
      "register",
      "login",
      "logout"
    ],
    "test_refs": [
      "TC-AUTH-01",
      "TC-AUTH-02"
    ],
    "rule": "注册不自动登录；口令使用 Argon2id(19MiB,2,1)；会话 24 小时失效，logout 撤销当前令牌。"
  },
  {
    "design_id": "DS-USER-01",
    "module": "用户与身份",
    "req_refs": [
      "LR-05"
    ],
    "contract_refs": [
      "get_me",
      "update_me",
      "list_my_posts",
      "list_my_claims"
    ],
    "test_refs": [
      "TC-USER-01"
    ],
    "rule": "身份从会话取得；update_me 仅接受 nickname；本人列表按 created_at/id 降序稳定分页。"
  },
  {
    "design_id": "DS-LOST-01",
    "module": "失物发布与搜索",
    "req_refs": [
      "LR-02"
    ],
    "contract_refs": [
      "publish_lost"
    ],
    "test_refs": [
      "TC-P01",
      "TC-P02",
      "TC-P03"
    ],
    "rule": "lost_at 必填且带时区；缺失/空/非法值拒绝且不写入；发布者取自当前身份，status=waiting。"
  },
  {
    "design_id": "DS-LOST-02",
    "module": "失物发布与搜索",
    "req_refs": [
      "LR-03"
    ],
    "contract_refs": [
      "search_lost",
      "get_lost"
    ],
    "test_refs": [
      "TC-SEARCH-01",
      "TC-SEARCH-02"
    ],
    "rule": "keyword 普通包含匹配，location 去空白后精确匹配；公开视图统一为 LostView。"
  },
  {
    "design_id": "DS-CLAIM-01",
    "module": "认领申请",
    "req_refs": [
      "LR-04"
    ],
    "contract_refs": [
      "create_claim"
    ],
    "test_refs": [
      "TC-CLAIM-01",
      "TC-CLAIM-02"
    ],
    "rule": "禁止认领本人信息；对象状态、权限、重复性与插入在同一事务；重复申请转 DUPLICATE_CLAIM。"
  },
  {
    "design_id": "DS-COMMON-01",
    "module": "公共契约",
    "req_refs": [
      "LR-01",
      "LR-02",
      "LR-03",
      "LR-04",
      "LR-05"
    ],
    "contract_refs": [
      "response_envelope",
      "error_mapping"
    ],
    "test_refs": [
      "TC-ERR-01"
    ],
    "rule": "成功固定 {ok:true,data:值}；失败固定 {ok:false,error:{code,field,message}} 且不含 data。"
  },
